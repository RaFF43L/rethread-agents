# general
APP_NAME=rethread-agents
APP_ENV=dev

# logging
LOG_LEVEL=INFO

# llm — provider POR PAPEL: anthropic | openai | ollama
#   LLM_PROVIDER/MODEL         -> especialistas (stylist / tamanho), precisam de tool calling
#   FAST_PROVIDER/MODEL_FAST   -> triagem e composição (default = LLM_PROVIDER)
#   JUDGE_PROVIDER/MODEL_JUDGE -> revisão de qualidade (default = LLM_PROVIDER / MODEL)
# Ao trocar o provider de um papel, troque também o modelo daquele papel.
LLM_PROVIDER=anthropic
MODEL=claude-sonnet-5-5
FAST_PROVIDER=
MODEL_FAST=claude-haiku-5-5
JUDGE_PROVIDER=
MODEL_JUDGE=

# credenciais / endpoints
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Opcional: qualquer API OpenAI-compatível (vLLM, LM Studio, OpenRouter...)
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# Exemplo — triagem local com Llama e especialistas com Claude:
#   FAST_PROVIDER=ollama
#   MODEL_FAST=llama3.1
# Exemplo — tudo OpenAI:
#   LLM_PROVIDER=openai
#   MODEL=gpt-4.1
#   MODEL_FAST=gpt-4.1-mini

# embeddings — Anthropic não oferece embeddings: use openai ou ollama.
# EMBED_DIMENSIONS precisa bater com a coluna `items.embedding` (definida na migration 001).
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
# Local: EMBED_PROVIDER=ollama / EMBED_MODEL=nomic-embed-text / EMBED_DIMENSIONS=768

# agent behavior
MAX_TOKENS=4096
AGENT_MAX_TOKENS=1200
MAX_ATTEMPTS=3
RECURSION_LIMIT=50
SEARCH_TOP_K=5
# Mensagens anteriores da sessão enviadas ao agent (cliente + atendente)
CHAT_HISTORY_MESSAGES=10

# catálogo / pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/rethread

# voz — no pipeline (channel=voice), cada segundo é silêncio na ligação
# 1 = sem refazer resposta reprovada pela revisão de qualidade
VOICE_MAX_ATTEMPTS=1
# especialistas usam MODEL_FAST em vez de MODEL
VOICE_FAST_SPECIALISTS=true

# voz — serviço voice/ (LiveKit). STT usa a OPENAI_API_KEY acima.
# No docker compose, LIVEKIT_* e RETHREAD_API_URL já vêm definidos (servidor em modo dev).
# Na imagem de produção, o agente de voz só sobe se LIVEKIT_URL estiver definida (LiveKit Cloud).
# Processos pré-aquecidos do agente de voz (cada um consome memória)
VOICE_IDLE_PROCESSES=1
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# RETHREAD_API_URL=http://localhost:8000
# gpt-live-transcribe: transcreve palavra por palavra enquanto o cliente fala
VOICE_STT_MODEL=gpt-live-transcribe
# true = transcrição em streaming (resultados parciais enquanto o cliente fala)
VOICE_STT_REALTIME=true
# TTS: elevenlabs quando ELEVENLABS_API_KEY está preenchida, senão openai.
VOICE_TTS_PROVIDER=
ELEVENLABS_API_KEY=
VOICE_ELEVENLABS_MODEL=eleven_flash_v2_5
# Vazio = voz padrão do plugin. Use o voice_id de uma voz pt-BR da sua conta.
VOICE_ELEVENLABS_VOICE_ID=
VOICE_OPENAI_TTS_MODEL=gpt-4o-mini-tts
VOICE_OPENAI_TTS_VOICE=coral

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=